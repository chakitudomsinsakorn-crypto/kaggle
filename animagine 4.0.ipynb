import os
import random
import torch
import gradio as gr
from diffusers import DiffusionPipeline, EulerAncestralDiscreteScheduler
from kaggle_secrets import UserSecretsClient

if not torch.cuda.is_available():
    raise RuntimeError("กรุณาเลือก Accelerator เป็น GPU T4 x2")

hf_token = UserSecretsClient().get_secret("HF_TOKEN")
os.environ["HF_TOKEN"] = hf_token
os.environ["CUDA_VISIBLE_DEVICES"] = "0"

print("GPU:", torch.cuda.get_device_name(0))
print("GPU count:", torch.cuda.device_count())

model_id = "cagliostrolab/animagine-xl-4.0-opt"

pipe = DiffusionPipeline.from_pretrained(
    model_id,
    torch_dtype=torch.float16,
    use_safetensors=True,
    token=hf_token,
)

pipe.scheduler = EulerAncestralDiscreteScheduler.from_config(
    pipe.scheduler.config
)
pipe.enable_model_cpu_offload()
pipe.enable_vae_slicing()
pipe.enable_vae_tiling()

def generate_anime_v4(prompt, negative_prompt, aspect_ratio,
                      steps, cfg_scale, seed):
    sizes = {
        "จัตุรัส (1:1)": (1024, 1024),
        "แนวตั้งมาตรฐาน (3:4)": (896, 1152),
        "แนวตั้ง (9:16 - มือถือ)": (832, 1216),
        "แนวนอน (16:9 - หน้าจอคอม)": (1216, 832),
    }
    width, height = sizes.get(aspect_ratio, (896, 1152))

    if seed is None or int(seed) == -1:
        actual_seed = random.randint(0, 2147483647)
    else:
        actual_seed = int(seed)

    generator = torch.Generator("cpu").manual_seed(actual_seed)

    try:
        with torch.inference_mode():
            result = pipe(
                prompt=prompt,
                negative_prompt=negative_prompt,
                width=width,
                height=height,
                num_inference_steps=int(steps),
                guidance_scale=float(cfg_scale),
                generator=generator,
            )
        torch.cuda.empty_cache()
        return result.images[0], actual_seed

    except torch.cuda.OutOfMemoryError:
        torch.cuda.empty_cache()
        raise gr.Error("VRAM ไม่พอ ลดขนาดภาพหรือ Steps")

with gr.Blocks(theme=gr.themes.Soft()) as demo:
    gr.Markdown("# 🌸 AI วาดภาพอนิเมะ Animagine XL 4.0")

    with gr.Row():
        with gr.Column():
            prompt_input = gr.Textbox(
                lines=3,
                label="Prompt",
                value="1girl, silver hair, blue eyes, stylish casual clothes, sunset city background, masterpiece, high score, great score, absurdres",
            )
            neg_prompt_input = gr.Textbox(
                lines=2,
                label="Negative Prompt",
                value="lowres, bad anatomy, bad hands, text, error, missing finger, extra digits, fewer digits, cropped, worst quality, low quality",
            )
            aspect_dropdown = gr.Dropdown(
                choices=[
                    "จัตุรัส (1:1)",
                    "แนวตั้งมาตรฐาน (3:4)",
                    "แนวตั้ง (9:16 - มือถือ)",
                    "แนวนอน (16:9 - หน้าจอคอม)",
                ],
                value="แนวตั้งมาตรฐาน (3:4)",
                label="สัดส่วนภาพ",
            )
            with gr.Row():
                steps_slider = gr.Slider(
                    15, 40, value=28, step=1,
                    label="Steps"
                )
                cfg_slider = gr.Slider(
                    1.0, 10.0, value=5.0, step=0.5,
                    label="CFG Scale"
                )
            seed_input = gr.Number(
                value=-1,
                label="Seed (-1 = สุ่ม)",
                precision=0,
            )
            generate_btn = gr.Button(
                "✨ วาดภาพ",
                variant="primary",
            )

        with gr.Column():
            output_image = gr.Image(label="ผลลัพธ์")
            seed_output = gr.Number(
                label="Seed ที่ใช้",
                interactive=False,
            )

    generate_btn.click(
        generate_anime_v4,
        [
            prompt_input,
            neg_prompt_input,
            aspect_dropdown,
            steps_slider,
            cfg_slider,
            seed_input,
        ],
        [output_image, seed_output],
    )

demo.queue(default_concurrency_limit=1).launch(
    share=True,
    debug=True,
)
